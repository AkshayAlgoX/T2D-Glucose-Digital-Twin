{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.glucose-twin.dev/v1/twin-card.json",
  "title": "TwinCard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_id", "synthetic", "calibrated_at", "calibration_stage", "parameters"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "subject_id": { "type": "string", "format": "uuid" },
    "synthetic": { "const": true },
    "calibrated_at": { "type": "string", "format": "date-time" },
    "calibration_stage": { "enum": ["ehr_prior", "nightly_map", "adapter_finetuned"] },
    "parameters": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["key", "value", "unit", "ci80", "prior_value"],
        "properties": {
          "key": { "enum": ["insulin_sensitivity_rel", "beta_cell_rel", "first_phase_rel", "egp_basal_mg_per_min", "t_max_min", "tau_isf_min", "dawn_amplitude"] },
          "value": { "type": "number" }, "unit": { "type": "string" },
          "ci80": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
          "prior_value": { "type": "number" } } }
    },
    "history": { "type": "array", "maxItems": 180,
      "items": { "type": "object", "additionalProperties": false, "required": ["date", "insulin_sensitivity_rel", "beta_cell_rel"],
        "properties": { "date": { "type": "string", "format": "date" }, "insulin_sensitivity_rel": { "type": "number" }, "beta_cell_rel": { "type": "number" } } } },
    "fit_quality": { "type": "object", "additionalProperties": false,
      "properties": { "rmse_60m_14d_mg_dl": { "type": "number" }, "coverage_80_pct_14d": { "type": "number", "minimum": 0, "maximum": 100 } } }
  }
}
