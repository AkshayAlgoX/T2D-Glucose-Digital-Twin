{
  "schema_id": "EW01-FRESHNESS-2",
  "schema_version": 2,
  "supersedes": {"schema_id": "EW01-FRESHNESS-1", "compatible": false},
  "digest": "sha256 of the canonical JSON of this document: keys sorted, separators ',' and ':', ASCII escapes, duplicate keys and non-finite numbers rejected",
  "csv": {
    "encoding": "utf-8",
    "header": "first line, exact column names in the order listed",
    "delimiter": ",",
    "line_terminator": "\n",
    "quoting": "none; a field containing a quote or carriage return is invalid",
    "cell_type": "string",
    "na_inference": false
  },
  "numeric_token": {
    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
    "rule": "digits beyond the field scale must all be zero; the canonical value is the integer number of units of 10^-scale"
  },
  "telemetry": {
    "file": "patient_cgm_telemetry.csv",
    "columns": ["patient_id", "timestamp", "glucose_level", "heart_rate", "hrv", "sleep_stage", "step_count", "meal_event", "carbs_g", "future_spike_2h"],
    "patient_id_pattern": "^P[0-9]{4}$",
    "timestamp": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$", "format": "%Y-%m-%d %H:%M:%S", "grid_step_s": 300, "fingerprint_time": "position i is relative time i * 300 s from the first sample of the patient or window"},
    "fields": [
      {"name": "glucose_level", "type": "scaled_integer", "scale": 0, "min": 40, "max": 400, "missing_tokens": ["", "NaN"], "missing_canonical": {"value": 0, "missing": 1}, "observed_canonical": {"missing": 0}},
      {"name": "heart_rate", "type": "scaled_integer", "scale": 1, "missing_tokens": []},
      {"name": "hrv", "type": "scaled_integer", "scale": 1, "missing_tokens": []},
      {"name": "sleep_stage", "type": "categorical", "codes": {"Awake": 0, "Light": 1, "Deep": 2, "REM": 3}, "missing_tokens": []},
      {"name": "step_count", "type": "scaled_integer", "scale": 0, "missing_tokens": []},
      {"name": "meal_event", "type": "scaled_integer", "scale": 0, "min": 0, "max": 1, "missing_tokens": []},
      {"name": "carbs_g", "type": "scaled_integer", "scale": 1, "missing_tokens": []}
    ],
    "validated_not_fingerprinted": {"future_spike_2h": ["0", "1"]}
  },
  "ehr": {
    "file": "patients_ehr.csv",
    "columns": ["patient_id", "age", "gender", "bmi", "genetic_risk_score", "hba1c", "diabetes_status", "height_cm", "weight_kg", "egfr", "diabetes_duration_years", "med_classes", "target_mean_glucose", "basal_glucose", "insulin_sensitivity_rel", "tmax0_min", "tau_isf_min"],
    "fields": [
      {"name": "age", "type": "scaled_integer", "scale": 0},
      {"name": "gender", "type": "categorical", "values": ["M", "F"]},
      {"name": "bmi", "type": "scaled_integer", "scale": 1},
      {"name": "genetic_risk_score", "type": "scaled_integer", "scale": 3},
      {"name": "hba1c", "type": "scaled_integer", "scale": 1},
      {"name": "diabetes_status", "type": "categorical", "values": ["Type 1", "Type 2", "Prediabetes", "Healthy"]},
      {"name": "height_cm", "type": "scaled_integer", "scale": 1},
      {"name": "weight_kg", "type": "scaled_integer", "scale": 1},
      {"name": "egfr", "type": "scaled_integer", "scale": 0},
      {"name": "diabetes_duration_years", "type": "scaled_integer", "scale": 1},
      {"name": "med_classes", "type": "string_list", "separator": ";", "empty_token": "", "empty_canonical": [], "order": "generator order preserved", "vocabulary": ["metformin", "sglt2i", "glp1_ra", "dpp4i", "sulfonylurea", "basal_insulin", "prandial_insulin"]},
      {"name": "target_mean_glucose", "type": "scaled_integer", "scale": 1},
      {"name": "basal_glucose", "type": "scaled_integer", "scale": 1},
      {"name": "insulin_sensitivity_rel", "type": "scaled_integer", "scale": 3},
      {"name": "tmax0_min", "type": "scaled_integer", "scale": 1},
      {"name": "tau_isf_min", "type": "scaled_integer", "scale": 1}
    ],
    "missing": "no EHR field accepts a missing value; only med_classes accepts the empty token, meaning no medication"
  },
  "truth": {
    "file": "patient_cgm_truth.csv",
    "columns": ["patient_id", "timestamp", "plasma_glucose", "interstitial_glucose"],
    "fingerprinted": false
  },
  "fingerprints": {
    "kinds": ["EHR", "CGM", "HR", "MULTI", "WINDOW288"],
    "preimage": "canonical JSON of {\"body\": body, \"fingerprint_kind\": kind, \"schema_digest\": schema digest, \"schema_id\": \"EW01-FRESHNESS-2\"}",
    "digest": "sha256 hex of the preimage bytes",
    "record": {"kind": "fingerprint kind", "schema_id": "EW01-FRESHNESS-2", "schema_digest": "schema digest", "digest": "preimage digest"},
    "bodies": {
      "EHR": "{\"fields\": {name: canonical value for every EHR field}}",
      "CGM": "{\"glucose_level\": {\"missing\": [...], \"value\": [...]}, \"n\": N, \"step_s\": 300}",
      "HR": "{\"heart_rate\": {\"value\": [...]}, \"n\": N, \"step_s\": 300}",
      "MULTI": "{\"carbs_g\": {\"value\": [...]}, \"glucose_level\": {\"missing\": [...], \"value\": [...]}, \"heart_rate\": {\"value\": [...]}, \"hrv\": {\"value\": [...]}, \"meal_event\": {\"value\": [...]}, \"n\": N, \"sleep_stage\": {\"value\": [...]}, \"step_count\": {\"value\": [...]}, \"step_s\": 300}",
      "WINDOW288": "{\"glucose_level\": {\"missing\": [...], \"value\": [...]}, \"n\": 288, \"step_s\": 300} for every 288 consecutive positions"
    }
  },
  "windows": {
    "length": 288,
    "stride": 1,
    "low_information": "fewer than 2 distinct observed glucose values strictly inside (40, 400); missing positions are excluded"
  },
  "dispositions": {
    "EHR": "REVIEW_REQUIRED",
    "CGM": "BLOCK",
    "HR": "BLOCK",
    "MULTI": "BLOCK",
    "WINDOW288_SUBSTANTIVE": "BLOCK",
    "WINDOW288_LOW_INFORMATION": "REVIEW_REQUIRED",
    "digest_match_without_disclosed_preimage": "UNKNOWN",
    "disclosed_preimage_differs": "COLLISION (not a finding)",
    "any_finding": "preparation blocked"
  },
  "reference_catalog": {
    "record_type": "EW01_FRESHNESS_REFERENCE_CATALOG",
    "requires": "authority signature; schema_id and schema_digest equal to this schema; every fingerprint record carries the same schema_id and schema_digest; coverage.complete is true; a catalog of any other schema version is rejected, never relabelled"
  }
}
