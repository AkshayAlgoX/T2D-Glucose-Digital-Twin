{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.glucose-twin.dev/v1/forecast-request.json",
  "title": "ForecastRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "subject_id"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "subject_id": { "type": "string", "format": "uuid" },
    "as_of": { "type": "string", "format": "date-time" },
    "include": { "type": "array", "uniqueItems": true, "items": { "enum": ["drivers", "scenarios", "twin_state", "ehr_context", "twin_overlay"] }, "default": ["drivers", "twin_state"] },
    "scenarios": {
      "type": "array", "maxItems": 4,
      "items": { "type": "object", "additionalProperties": false, "required": ["scenario_id", "inputs"],
        "properties": { "scenario_id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" }, "label": { "type": "string", "maxLength": 60 },
                        "inputs": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "forecast-response.json#/$defs/ScenarioInput" } } } }
    },
    "alert_policy_version": { "type": "string" }
  }
}
